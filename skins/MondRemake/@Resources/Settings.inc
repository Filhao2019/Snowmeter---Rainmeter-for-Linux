[Variables]
; ----------------------------------------------------------------------------
; Mond Remake settings. Right-click any Mond Remake widget > "Edit settings",
; change a value, save, then right-click > Refresh (or use the menu toggles).
; ----------------------------------------------------------------------------

; Language of day/month names and weather text: en, pt, es, fr, de, it
Language=en

; 1 = 24-hour clock (14:30), 0 = 12-hour clock (2:30 PM)
Hour24=1

; Temperature units: celsius or fahrenheit
Units=celsius

; Weather location. Easiest: right-click the weather widget > "Set location"
; and type a city name. Coordinates are decimal degrees.
City=Lisbon
Latitude=38.7167
Longitude=-9.1333

; Music player to follow: Default (whatever is playing), or part of its name:
; Spotify, VLC, Firefox, Chromium, Rhythmbox, Elisa, Strawberry, mpv, ...
Player=Default

; Colours as R,G,B or R,G,B,Alpha (0-255)
TextColor=255,255,255
SubColor=255,255,255,170
AccentColor=255,145,40

; Fonts: the first installed one is used. Anurati (the original Mond font,
; free for personal use) is downloaded by `snowmeter install MondRemake`;
; Syncopate and Quicksand ship with this skin.
DisplayFont=Anurati,Syncopate
TextFont=Quicksand
